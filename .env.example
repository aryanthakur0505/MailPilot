# ==================================================
# MailPilot — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in the values.

# --------------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------------
# Use Neon, Supabase, or local PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/mailpilot?schema=public"

# --------------------------------------------------
# Auth.js / NextAuth
# --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --------------------------------------------------
# Google OAuth
# --------------------------------------------------
# Create at: https://console.cloud.google.com/apis/credentials
# Enable Gmail API + Google Calendar API
# Set redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------------
# Microsoft OAuth (Azure Entra ID)
# --------------------------------------------------
# Create at: https://portal.azure.com → App registrations
# Set redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
# API permissions: Mail.Read, Mail.Send, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --------------------------------------------------
# Redis
# --------------------------------------------------
# Use Upstash or local Redis
REDIS_URL="redis://localhost:6379"

# --------------------------------------------------
# App
# --------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
